    "components": {
        "schemas": {
            "AvailabilityRequest": {
                "properties": {
                    "available": {
                        "type": "boolean",
                        "title": "Available"
                    }
                },
                "type": "object",
                "required": [
                    "available"
                ],
                "title": "AvailabilityRequest",
                "description": "Manual product availability change."
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "OrderItemIn": {
                "properties": {
                    "product_id": {
                        "type": "string",
                        "minLength": 1,
                        "title": "Product Id"
                    },
                    "quantity": {
                        "type": "integer",
                        "minimum": 1.0,
                        "title": "Quantity"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                    "product_id",
                    "quantity"
                ],
                "title": "OrderItemIn"
            },
            "OrderOutcome": {
                "type": "string",
                "enum": [
                    "accepted",
                    "refused"
                ],
                "title": "OrderOutcome"
            },
            "OrderRequest": {
                "properties": {
                    "channel": {
                        "type": "string",
                        "minLength": 1,
                        "title": "Channel"
                    },
                    "external_order_id": {
                        "type": "string",
                        "minLength": 1,
                        "title": "External Order Id"
                    },
                    "vendor_id": {
                        "type": "string",
                        "minLength": 1,
                        "title": "Vendor Id"
                    },
                    "customer_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Customer Id"
                    },
                    "customer_geohash": {
                        "anyOf": [
                            {
                                "type": "string",
                                "pattern": "^[0-9a-z]{5}$"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Customer Geohash"
                    },
                    "order_day": {
                        "type": "integer",
                        "minimum": 0.0,
                        "title": "Order Day"
                    },
                    "order_time": {
                        "type": "string",
                        "format": "time",
                        "title": "Order Time"
                    },
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/OrderItemIn"
                        },
                        "type": "array",
                        "minItems": 1,
                        "title": "Items"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                    "channel",
                    "external_order_id",
                    "vendor_id",
                    "order_day",
                    "order_time",
                    "items"
                ],
                "title": "OrderRequest",
                "description": "Body of POST /orders. order_day and order_time are simulated time."
            },
            "OrderResponse": {
                "properties": {
                    "outcome": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/OrderOutcome"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "duplicate": {
                        "type": "boolean",
                        "title": "Duplicate",
                        "default": false
                    },
                    "order_id": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "uuid"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Order Id"
                    },
                    "order_day": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Order Day"
                    },
                    "status": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/OrderStatus"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "menu_version": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Menu Version"
                    },
                    "committed_at": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date-time"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Committed At"
                    },
                    "refusal_reason": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/RefusalReason"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "queued": {
                        "type": "boolean",
                        "title": "Queued",
                        "default": false
                    },
                    "region_id": {
                        "type": "string",
                        "title": "Region Id"
                    },
                    "received_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Received At"
                    },
                    "acked_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Acked At"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                    "region_id",
                    "received_at",
                    "acked_at"
                ],
                "title": "OrderResponse",
                "description": "What POST /orders returns: the region's result plus gateway facts.\n\nqueued=True means the region was unreachable and the order is parked in\nHQ's holding queue; outcome is then not known yet."
            },
            "OrderStatus": {
                "type": "string",
                "enum": [
                    "received",
                    "accepted",
                    "preparing",
                    "ready",
                    "picked_up",
                    "canceled"
                ],
                "title": "OrderStatus"
            },
            "RefusalReason": {
                "type": "string",
                "enum": [
