{
  "components": {
    "schemas": {
      "ClusterEvent": {
        "properties": {
          "detail": {
            "additionalProperties": true,
            "title": "Detail",
            "type": "object"
          },
          "event_id": {
            "title": "Event Id",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "node_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Node Id"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "region_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region Id"
          }
        },
        "required": [
          "event_id",
          "occurred_at",
          "kind",
          "region_id",
          "node_id"
        ],
        "title": "ClusterEvent",
        "type": "object"
      },
      "ClusterStatus": {
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/NodeStatus"
            },
            "title": "Nodes",
            "type": "array"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/RegionStatus"
            },
            "title": "Regions",
            "type": "array"
          }
        },
        "required": [
          "as_of",
          "nodes",
          "regions"
        ],
        "title": "ClusterStatus",
        "type": "object"
      },
      "ExceptionEntry": {
        "properties": {
          "attempted_at": {
            "format": "date-time",
            "title": "Attempted At",
            "type": "string"
          },
          "attempted_status": {
            "title": "Attempted Status",
            "type": "string"
          },
          "current_changed_at": {
            "format": "date-time",
            "title": "Current Changed At",
            "type": "string"
          },
          "current_status": {
            "title": "Current Status",
            "type": "string"
          },
          "hq_applied_at": {
            "format": "date-time",
            "title": "Hq Applied At",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "order_day": {
            "title": "Order Day",
            "type": "integer"
          },
          "order_id": {
            "format": "uuid",
            "title": "Order Id",
            "type": "string"
          },
          "region_id": {
            "title": "Region Id",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          }
        },
        "required": [
          "seq",
          "region_id",
          "order_day",
          "order_id",
          "kind",
          "current_status",
          "current_changed_at",
          "attempted_status",
          "attempted_at",
          "hq_applied_at"
        ],
        "title": "ExceptionEntry",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NodeStatus": {
        "properties": {
          "last_heartbeat_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Heartbeat At"
          },
          "node_id": {
            "title": "Node Id",
            "type": "string"
          },
          "region_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region Id"
          },
          "role": {
            "enum": [
              "primary",
              "standby"
            ],
            "title": "Role",
            "type": "string"
          },
          "status": {
            "default": "suspect",
            "enum": [
              "up",
              "suspect",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "node_id",
          "region_id",
          "role"
        ],
        "title": "NodeStatus",
        "type": "object"
      },
      "RegionStatus": {
        "properties": {
          "epoch": {
            "title": "Epoch",
            "type": "integer"
          },
          "figures_as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Figures As Of"
          },
          "holding_queue": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Holding Queue"
          },
          "hq_lag_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hq Lag S"
          },
          "menu_version": {
            "title": "Menu Version",
            "type": "integer"
          },
          "orders_per_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Orders Per S"
          },
          "outbox_backlog": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outbox Backlog"
          },
          "primary_node": {
            "title": "Primary Node",
            "type": "string"
          },
          "region_id": {
            "title": "Region Id",
            "type": "string"
          },
          "replication": {
            "anyOf": [
              {
                "enum": [
                  "sync",
                  "async"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replication"
          },
          "standby_lag_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Standby Lag S"
          },
          "standby_node": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Standby Node"
          }
        },
        "required": [
          "region_id",
          "epoch",
          "menu_version",
          "primary_node",
          "standby_node"
        ],
        "title": "RegionStatus",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Node health monitoring and admin reads. Promotion is a follow-up increment.",
    "title": "RestaurantOS coordinator",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/cluster": {
      "get": {
        "operationId": "cluster_admin_cluster_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Cluster"
      }
    },
    "/admin/events": {
      "get": {
        "operationId": "events_admin_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClusterEvent"
                  },
                  "title": "Response Events Admin Events Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Events"
      }
    },
    "/admin/exceptions": {
      "get": {
        "operationId": "exceptions_admin_exceptions_get",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ExceptionEntry"
                  },
                  "title": "Response Exceptions Admin Exceptions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Exceptions"
      }
    }
  }
}
