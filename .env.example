# RestaurantOS environment variables. Copy to .env (git-ignored) and adjust.
# Every variable has the default shown; unset keys fall back to these.
# Python settings come from restaurantos.common.config (prefix ROS_).
# Nothing here is a real secret; this is a simulation.

# --- Where this process runs ---
# compose: inside the Compose network (a service container).
# host: on the Docker host, started with `uv run`; use this for rosctl and for
# running services while you develop. Databases and proxies are then reached
# on 127.0.0.1 through the ports the Compose file publishes.
# ROS_NETWORK=compose

# --- Who this process is ---
# Toxiproxy proxy-name component: gateway, coordinator, hq, relay-r1, ...
# ROS_CLIENT=gateway
# gateway, or the region-local edge API
# ROS_MODE=gateway
# Set for region-side processes (r1, r2, ...)
# ROS_REGION_ID=

# --- Where things are ---
# Cleaned dataset CSVs (git-ignored). Relative to the working directory.
# ROS_DATA_DIR=data
# Cluster definition the Toxiproxy/Compose generators read.
# ROS_CLUSTER_FILE=infra/cluster.toml
# Override the SQL directory (tests use this to point at the repo db/ tree).
# Read from the real environment only, not from .env: export it, or run
# `uv run --env-file .env ...`. The same goes for ROS_TEST_DSN below.
# ROS_DB_DIR=db

# --- Database access ---
# ROS_DB_NAME=restaurantos
# ROS_DB_USER=ros
# ROS_DB_PASSWORD=ros
# How fast a failed or hung connection gives up, in seconds (Toxiproxy
# timeouts make this matter).
# ROS_CONNECT_TIMEOUT_S=1.0
# Server-side per-statement kill switch, in milliseconds.
# ROS_STATEMENT_TIMEOUT_MS=2000
# The server ends a session that sits inside an open transaction this long.
# ROS_IDLE_IN_TRANSACTION_TIMEOUT_MS=5000
# How long a request path waits for a database call before it treats the
# region as unreachable. Kept by the caller, so it also holds on a silent
# link. Keep it above the statement timeout.
# ROS_REQUEST_DEADLINE_S=3.0
# ROS_POOL_MIN_SIZE=1
# ROS_POOL_MAX_SIZE=10

# --- Toxiproxy control API ---
# Follows ROS_NETWORK when unset: http://toxiproxy:8474 inside the Compose
# network, http://127.0.0.1:8474 on the host.
# ROS_TOXIPROXY_URL=http://toxiproxy:8474

# --- Component settings ---
# Each component keeps its own settings in src/restaurantos/<component>/config.py
# with the prefix ROS_<COMPONENT>_. Add a line here when you add a setting.
# Required for relay processes: region for an outbox relay, hq for the HQ worker.
# ROS_RELAY_ROLE=
# Named by the work-package briefs (defaults shown):
# ROS_GATEWAY_DIRECTORY_REFRESH_S=5
# ROS_GATEWAY_LOCAL_CHECK_S=1
# ROS_RELAY_POLL_INTERVAL_S=0.5
# ROS_RELAY_BATCH_SIZE=500
# ROS_RELAY_LOCAL_CHECK_S=1
# ROS_COORDINATOR_HEARTBEAT_INTERVAL_S=1
# ROS_COORDINATOR_HEARTBEAT_MISSES=3
# ROS_COORDINATOR_HEARTBEAT_TIMEOUT_S=0.8
# Gateway probes can take the gateway's full 3-second DB deadline.
# ROS_COORDINATOR_GATEWAY_TIMEOUT_S=4
# Unset: http://127.0.0.1:8000 in host mode, http://gateway:8000 in compose mode.
# ROS_COORDINATOR_GATEWAY_URL=
# Total budget for a resumable regional promotion, including the gateway check.
# ROS_COORDINATOR_FAILOVER_TIMEOUT_S=15
# Time budget per rewind/clone command and the standby readiness attempts.
# ROS_COORDINATOR_REJOIN_TIMEOUT_S=300

# --- Integration tests ---
# psycopg DSN to a throwaway database; integration tests skip without it.
# Example for the local Compose cluster:
# ROS_TEST_DSN=host=localhost port=5510 dbname=restaurantos_test user=ros

# --- Docker Compose ---
# PostgreSQL image for every node. The default is pinned by digest in
# infra/compose.yaml; override only for a deliberate upgrade.
# ROS_POSTGRES_IMAGE=postgres:18@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42
# Compose does not read this file automatically: it looks for .env next to
# infra/compose.yaml, so either run compose from infra/ or pass
# `--env-file .env` at the repo root.

# --- WP6a: bootstrap and stock parameters (ROS_SIM_ prefix) ---
# The stock rules are documented in docs/replay-stock-parameters.md: usage
# is measured on the first ROS_SIM_STOCK_WARM_UP_DAYS days only, and every
# counter starts at max(ROS_SIM_STOCK_FLOOR,
# ceil(average daily warm-up usage x ROS_SIM_STOCK_COVER_DAYS)).
# ROS_SIM_STOCK_WARM_UP_DAYS=14
# ROS_SIM_STOCK_COVER_DAYS=7
# ROS_SIM_STOCK_FLOOR=5
# Restock every R days of replay: at 00:00:00 of days W+R, W+2R, ...
# playback restocks every vendor back to its par level.
# ROS_SIM_STOCK_RESTOCK_DAYS=7

# --- WP6a: playback (ROS_SIM_ prefix) ---
# Simulated seconds per wall-clock second. Change it mid-run with
# `rosctl playback speed N` (the run re-anchors; simulated time never jumps).
# ROS_SIM_PLAYBACK_SPEED=1000
# Requests a run keeps open at once.
# ROS_SIM_PLAYBACK_INFLIGHT=64
# How long `stop` waits for in-flight requests before abandoning them
# (abandoned lines are marked in the run log).
# ROS_SIM_PLAYBACK_DRAIN_TIMEOUT_S=30
# The API base playback POSTs orders to: {target}/orders. The gateway on the
# host by default; point it at the stub (`python -m restaurantos.sim.stub`)
# to run without the gateway.
# ROS_SIM_PLAYBACK_TARGET_URL=http://127.0.0.1:8000/api/v1
# The host the region edge APIs listen on. Status events and restocks are
# kitchen-side actions, so playback sends them to each region's own edge
# API (port 8010 + n on this host) - the edge survives a gateway cut,
# which is the scenario the replay must show working. Orders keep going
# to the target above. A stub run passes the stub's URL to
# `rosctl playback start --kitchen-target` instead.
# ROS_SIM_PLAYBACK_EDGE_HOST=127.0.0.1
# Per-request HTTP timeout for playback's sends.
# ROS_SIM_HTTP_TIMEOUT_S=5
# Where the /sim control routes listen while a playback run is live
# (architecture Section 6.3; the WP7 UI drives playback through them).
# ROS_SIM_CONTROL_HOST=127.0.0.1
# ROS_SIM_CONTROL_PORT=8002
# Origins allowed to call the control API from a browser: they get CORS
# headers (preflight included) and pass the origin guard. Format:
# comma-separated exact origins like http://localhost:5173 - no paths, no
# `*`; an invalid entry stops the process at startup. A Sec-Fetch-Site:
# cross-site request is rejected even when its Origin is listed, and
# browsers decide same-site by scheme + registrable domain, ignoring
# the port: use the same scheme and hostname for the browser client
# and the control API. CLI clients (rosctl, curl) send no Origin and
# are always allowed; empty (the default) means CLI-only, with no CORS
# headers at all.
# ROS_SIM_CONTROL_ALLOWED_ORIGINS=
# The invariant checker (rosctl check): how long it waits for the outbox
# and the holding queue to drain before it fails, and how often it looks.
# ROS_SIM_CHECK_DRAIN_TIMEOUT_S=300
# ROS_SIM_CHECK_POLL_S=1
# Snapshots (rosctl snapshot save|restore|list, architecture 7.4): where
# they go; how far into the simulated day the run's dispatch must be
# before a snapshot pauses it (00:30 by default; save refuses a value
# below the last status event's offset plus the playback host's jitter,
# about 00:26-00:27, or 1 s with events off); how long it waits for
# in-flight requests;
# and the catch-up speed and margin restore uses to replay the day.
# ROS_SIM_SNAPSHOT_DIR=snapshots
# ROS_SIM_SNAPSHOT_MIN_DAY_OFFSET_S=1800
# ROS_SIM_SNAPSHOT_DRAIN_TIMEOUT_S=60
# ROS_SIM_SNAPSHOT_CATCHUP_SPEED=5000
# ROS_SIM_SNAPSHOT_CATCHUP_MARGIN_S=600
# Status events (accepted, preparing, ready, picked_up at +1, +3, +15,
# +25 simulated minutes plus jitter) for every accepted order. Turn off
# with `rosctl playback start --no-events`.
# ROS_SIM_PLAYBACK_STATUS_EVENTS=1
# Share of orders that get their full event set (an order is in or out;
# 1.0 = every accepted order). Deterministic per (seed, order).
# ROS_SIM_PLAYBACK_EVENT_SAMPLE_RATE=1.0
# Jitter is uniform in [0, N) simulated seconds per event, drawn per
# (seed, order, event). N may be at most the smallest gap between two
# events of one order (120 s). Draws are in [0, N), so an event is
# never due before its predecessor.
# ROS_SIM_PLAYBACK_EVENT_JITTER_S=60
# Kitchen calls (status events, restocks) retry a timeout, a connection
# error or a 5xx this many times in total, backing off 0.5 s, 1 s, 2 s
# in wall time between attempts. Every attempt sends the same event id,
# so a repeat of a committed change answers duplicate and counts as
# acked. A 2xx, 404, 409 or 422 is never retried.
# ROS_SIM_PLAYBACK_KITCHEN_ATTEMPTS=3
# Duplicates and shuffle (architecture 7.2). An order is resent when its
# hash of (seed, order) is below the rate - the same seed resends the same
# orders, and the share comes close to the rate over a long run but is not
# guaranteed to equal it - with the same request body, so the region's
# inbox answers duplicate (the idempotency exercise). A resend lands
# within ROS_SIM_PLAYBACK_DUPLICATE_OFFSET_S simulated seconds after its
# order. Shuffle reorders delivery inside a bounded window: the next
# delivery is the smallest shuffle key among the next
# ROS_SIM_SHUFFLE_WINDOW stream items (1 = no reorder). Both off by
# default; shuffle is refused together with --sequential.
# ROS_SIM_PLAYBACK_DUPLICATE_RATE=0.0
# ROS_SIM_PLAYBACK_DUPLICATE_OFFSET_S=1.0
# ROS_SIM_PLAYBACK_SHUFFLE=0
# ROS_SIM_SHUFFLE_WINDOW=8
