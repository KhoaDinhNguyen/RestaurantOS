# RestaurantOS environment variables. Copy to .env (git-ignored) and adjust.
# Every variable has the default shown; unset keys fall back to these.
# Python settings come from restaurantos.common.config (prefix ROS_).
# Nothing here is a real secret; this is a simulation.

# --- Who this process is ---
# Toxiproxy proxy-name component: gateway, coordinator, hq, relay-r1, ...
# ROS_CLIENT=gateway
# gateway, or the region-local edge API
# ROS_MODE=gateway
# Set for region-side processes (r1, r2, ...)
# ROS_REGION_ID=

# --- Where things are ---
# Cleaned dataset CSVs (git-ignored). Relative to the working directory.
# ROS_DATA_DIR=data
# Cluster definition the Toxiproxy/Compose generators read.
# ROS_CLUSTER_FILE=infra/cluster.toml
# Override the SQL directory (tests use this to point at the repo db/ tree).
# ROS_DB_DIR=db

# --- Database access ---
# ROS_DB_NAME=restaurantos
# ROS_DB_USER=ros
# ROS_DB_PASSWORD=ros
# How fast a failed or hung connection gives up, in seconds (Toxiproxy
# timeouts make this matter).
# ROS_CONNECT_TIMEOUT_S=1.0
# Server-side per-statement kill switch, in milliseconds.
# ROS_STATEMENT_TIMEOUT_MS=2000
# ROS_POOL_MIN_SIZE=1
# ROS_POOL_MAX_SIZE=10

# --- Toxiproxy control API ---
# ROS_TOXIPROXY_URL=http://toxiproxy:8474

# --- Integration tests ---
# psycopg DSN to a throwaway database; integration tests skip without it.
# Example for the local Compose cluster:
# ROS_TEST_DSN=host=localhost port=5510 dbname=restaurantos_test user=ros

# --- Docker Compose ---
# PostgreSQL image for every node. The default is pinned by digest in
# infra/compose.yaml; override only for a deliberate upgrade.
# ROS_POSTGRES_IMAGE=postgres:18@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42
# Compose does not read this file automatically: it looks for .env next to
# infra/compose.yaml, so either run compose from infra/ or pass
# `--env-file .env` at the repo root.
