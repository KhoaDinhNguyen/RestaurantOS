# RestaurantOS environment variables. Copy to .env (git-ignored) and adjust.
# Every variable has the default shown; unset keys fall back to these.
# Python settings come from restaurantos.common.config (prefix ROS_).
# Nothing here is a real secret; this is a simulation.

# --- Where this process runs ---
# compose: inside the Compose network (a service container).
# host: on the Docker host, started with `uv run`; use this for rosctl and for
# running services while you develop. Databases and proxies are then reached
# on 127.0.0.1 through the ports the Compose file publishes.
# ROS_NETWORK=compose

# --- Who this process is ---
# Toxiproxy proxy-name component: gateway, coordinator, hq, relay-r1, ...
# ROS_CLIENT=gateway
# gateway, or the region-local edge API
# ROS_MODE=gateway
# Set for region-side processes (r1, r2, ...)
# ROS_REGION_ID=

# --- Where things are ---
# Cleaned dataset CSVs (git-ignored). Relative to the working directory.
# ROS_DATA_DIR=data
# Cluster definition the Toxiproxy/Compose generators read.
# ROS_CLUSTER_FILE=infra/cluster.toml
# Override the SQL directory (tests use this to point at the repo db/ tree).
# Read from the real environment only, not from .env: export it, or run
# `uv run --env-file .env ...`. The same goes for ROS_TEST_DSN below.
# ROS_DB_DIR=db

# --- Database access ---
# ROS_DB_NAME=restaurantos
# ROS_DB_USER=ros
# ROS_DB_PASSWORD=ros
# How fast a failed or hung connection gives up, in seconds (Toxiproxy
# timeouts make this matter).
# ROS_CONNECT_TIMEOUT_S=1.0
# Server-side per-statement kill switch, in milliseconds.
# ROS_STATEMENT_TIMEOUT_MS=2000
# The server ends a session that sits inside an open transaction this long.
# ROS_IDLE_IN_TRANSACTION_TIMEOUT_MS=5000
# How long a request path waits for a database call before it treats the
# region as unreachable. Kept by the caller, so it also holds on a silent
# link. Keep it above the statement timeout.
# ROS_REQUEST_DEADLINE_S=3.0
# ROS_POOL_MIN_SIZE=1
# ROS_POOL_MAX_SIZE=10

# --- Toxiproxy control API ---
# Follows ROS_NETWORK when unset: http://toxiproxy:8474 inside the Compose
# network, http://127.0.0.1:8474 on the host.
# ROS_TOXIPROXY_URL=http://toxiproxy:8474

# --- Component settings ---
# Each component keeps its own settings in src/restaurantos/<component>/config.py
# with the prefix ROS_<COMPONENT>_. Add a line here when you add a setting.
# Named by the work-package briefs (defaults shown):
# ROS_GATEWAY_DIRECTORY_REFRESH_S=5
# ROS_GATEWAY_LOCAL_CHECK_S=1
# ROS_RELAY_POLL_INTERVAL_S=0.5
# ROS_RELAY_BATCH_SIZE=500
# ROS_RELAY_LOCAL_CHECK_S=1
# ROS_COORDINATOR_HEARTBEAT_INTERVAL_S=1
# ROS_COORDINATOR_HEARTBEAT_MISSES=3

# --- Integration tests ---
# psycopg DSN to a throwaway database; integration tests skip without it.
# Example for the local Compose cluster:
# ROS_TEST_DSN=host=localhost port=5510 dbname=restaurantos_test user=ros

# --- Docker Compose ---
# PostgreSQL image for every node. The default is pinned by digest in
# infra/compose.yaml; override only for a deliberate upgrade.
# ROS_POSTGRES_IMAGE=postgres:18@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42
# Compose does not read this file automatically: it looks for .env next to
# infra/compose.yaml, so either run compose from infra/ or pass
# `--env-file .env` at the repo root.

# --- WP6a: bootstrap and stock parameters (ROS_SIM_ prefix) ---
# The stock rules are documented in docs/replay-stock-parameters.md: usage
# is measured on the first ROS_SIM_STOCK_WARM_UP_DAYS days only, and every
# counter starts at max(ROS_SIM_STOCK_FLOOR,
# ceil(average daily warm-up usage x ROS_SIM_STOCK_COVER_DAYS)).
# ROS_SIM_STOCK_WARM_UP_DAYS=14
# ROS_SIM_STOCK_COVER_DAYS=7
# ROS_SIM_STOCK_FLOOR=5
